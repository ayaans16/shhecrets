# Copied to .env for local dev; real values come from AWS Secrets Manager once deployed.

REDIS_URL=redis://localhost:6379/0

# How long a session lives if never read. Kept short by default since these
# are meant to be handed off within minutes, not stored.
SESSION_TTL_SECONDS=600

# Comma-separated origins allowed to call the API (the frontend's dev/prod URLs).
CORS_ORIGINS=http://localhost:5173

# Fixed-window rate limits, "<max requests>/<window seconds>". Separate limits
# for create vs read because read attempts are the more sensitive one to
# throttle (that's where session-ID guessing/enumeration would happen).
RATE_LIMIT_CREATE=10/60
RATE_LIMIT_READ=20/60
