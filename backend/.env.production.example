# Copy to .env.production on the VPS (NOT committed - see .gitignore)
# and fill in real values. docker-compose.prod.yml loads this file.

# Set by docker-compose.prod.yml's `environment:` block to the compose
# service names (redis/mongo) - no need to set these here, listed for
# reference only.
# REDIS_URL=redis://redis:6379/0
# MONGO_URL=mongodb://mongo:27017

SESSION_TTL_SECONDS=600

MONGO_DB_NAME=shhecrets

# Generate a real one: `openssl rand -hex 32`. The local-dev default in
# .env.example must never be used here - it's public (it's committed to
# the repo), so using it in production defeats the whole point of
# hashing IPs in the first place.
IP_HASH_PEPPER=

# Only the real production origin - do not include localhost dev ports
# here. Cloudflare/Caddy terminate TLS, so this is the browser-facing
# https:// origin, not anything internal to the compose network.
CORS_ORIGINS=https://shhecrets.ca

RATE_LIMIT_CREATE=10/60
RATE_LIMIT_READ=20/60
